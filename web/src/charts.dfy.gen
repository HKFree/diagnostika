    i := (i + 1);
  }
  return top;
}

method niceTop(peak: int) returns (res: int)
  requires (peak >= 0)
  ensures (res >= peak)
  ensures (res >= 1)
{
  var base := 1;
  var k := 0;
  while ((k < 40) && ((base * 5) < peak))
    invariant (base >= 1)
    invariant (0 <= k)
    invariant (k <= 40)
    decreases (40 - k)
  {
    base := (base * 10);
    k := (k + 1);
  }
  if (base >= peak) {
    return base;
  }
  if ((base * 2) >= peak) {
    return (base * 2);
  }
  if ((base * 5) >= peak) {
    return (base * 5);
  }
  return peak;
}

