  ensures forall k: int :: ((0 <= k) ==> (k < |present|) ==> (res[k] == 2) ==> ((k > 0) && present[(k - 1)]))
  ensures forall k: int :: ((0 < k) ==> (k < |present|) ==> present[k] ==> present[(k - 1)] ==> (res[k] == 2))
{
  var out: seq<int> := [];
  var i := 0;
  while (i < |present|)
    invariant (0 <= i)
    invariant (i <= |present|)
    invariant (|out| == i)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((out[k] == 0) == !(present[k])))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (((out[k] == 0) || (out[k] == 1)) || (out[k] == 2)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (out[k] == 2) ==> ((k > 0) && present[(k - 1)]))
