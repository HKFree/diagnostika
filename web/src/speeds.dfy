function serverDone(status: int): bool
{
  ((status == 200) || ((status >= 400) && (status < 500)))
}

lemma serverDone_ensures(status: int)
  ensures (serverDone(status) == ((status == 200) || ((400 <= status) && (status < 500))))
  ensures ((status >= 500) ==> !(serverDone(status)))
  ensures ((status == 0) ==> !(serverDone(status)))
