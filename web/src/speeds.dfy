function fitsOutage(measuredAt: int, detectedAt: int): bool
{
  ((measuredAt <= detectedAt) && ((detectedAt - measuredAt) <= 86400))
}

lemma fitsOutage_ensures(measuredAt: int, detectedAt: int)
  ensures (fitsOutage(measuredAt, detectedAt) == ((measuredAt <= detectedAt) && ((detectedAt - measuredAt) <= 86400)))
{
