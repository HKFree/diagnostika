method unsentPositions(ids: seq<string>, sent: set<string>) returns (res: seq<int>)
  ensures forall k: int :: ((0 <= k) ==> (k < |res|) ==> ((0 <= res[k]) && (res[k] < |ids|)))
  ensures forall k: int :: ((0 <= k) ==> (k < |res|) ==> !((ids[res[k]] in sent)))
  ensures forall k: int :: ((0 < k) ==> (k < |res|) ==> (res[(k - 1)] < res[k]))
  ensures forall j: int :: ((0 <= j) ==> (j < |ids|) ==> !((ids[j] in sent)) ==> exists k: int :: (((0 <= k) && (k < |res|)) && (res[k] == j)))
{
  var out: seq<int> := [];
  var i := 0;
  while (i < |ids|)
    invariant (0 <= i)
    invariant (i <= |ids|)
    invariant forall k: int :: ((0 <= k) ==> (k < |out|) ==> ((0 <= out[k]) && (out[k] < i)))
    invariant forall k: int :: ((0 <= k) ==> (k < |out|) ==> !((ids[out[k]] in sent)))
    invariant forall k: int :: ((0 < k) ==> (k < |out|) ==> (out[(k - 1)] < out[k]))
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> !((ids[j] in sent)) ==> exists k: int :: (((0 <= k) && (k < |out|)) && (out[k] == j)))
    decreases (|ids| - i)
  {
    ghost var before := out;
    if !((ids[i] in sent)) {
      out := (out + [i]);
      // The new position is its own witness; earlier ones keep theirs.
      assert out[|out| - 1] == i;
    }
    assert forall k: int :: 0 <= k < |before| ==> out[k] == before[k];
    i := (i + 1);
  }
  return out;
}
