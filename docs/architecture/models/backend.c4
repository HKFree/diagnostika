model {
  extend diagnostika.backend {
    web = component 'Webová služba / Web service' {
      description 'Serves the app, the network map, the device\'s address, outage reports and admin logins.'
      technology 'Rust, tiny_http'
    }
    mapBuilder = component 'Sestavení mapy / Map builder' {
      description 'Builds the network map from the OSPF database, the IPv6 routes, network monitoring and the member records.'
      technology 'Rust'
    }
    reports = component 'Hlášení výpadků / Outage reports' {
      description 'Accepts, checks and keeps outage reports.'
      technology 'Rust'
    }
    adminLogin = component 'Přihlášení správců / Admin login' {
      description 'Lets in a member whose hkfree.org account holds an admin role (SO, ZSO, TECH, VV) and keeps them logged in on that device for 30 days.'
      technology 'Rust'
    }
    history = component 'Historie měření / Measurement history' {
      description 'Gets a router\'s response time and packet loss, or the requesting device\'s own traffic, over the last day or week; only routers of the network map and the AP\'s devices have a public history, traffic only goes to its own address. Kept for a few minutes.'
      technology 'Rust'
    }
    reportStore = store 'Databáze hlášení / Report database' {
      description 'The outage reports with members\' addresses.'
      technology 'SQLite'
    }

    web -> mapBuilder 'asks for the current network map'
    web -> reports 'passes on outage reports and report queries'
    web -> adminLogin 'checks logins and admin sessions'
    adminLogin -> memberRecords 'checks the account and its admin role'
    reports -> reportStore 'stores and reads reports'
    mapBuilder -> ospfRouter 'reads the OSPF database'
    mapBuilder -> ospf6Router 'reads which router advertises which IPv6 prefix (/29 and longer)'
    web -> history 'asks for a router\'s history or the device\'s own traffic'
    history -> monitoring 'asks for the measured series of one address (Grafana\'s data source API)'
    web -> powerMonitor 'reads backup power and announced power cuts every minute, for the outage overview'
    mapBuilder -> mikrotikRouters 'reads their OSPF databases and default route (REST, read-only) and merges them, newest record first'
    mapBuilder -> monitoring 'asks which routers answer'
    mapBuilder -> memberRecords 'reads AP names and admins'
  }
}
