model {
  extend diagnostika.app {
    check = component 'Kontrola / Check' {
      description 'Runs a check and turns its findings into the check result and advice.'
      technology 'JavaScript module'
    }
    probes = component 'Testy ze zařízení / Device tests' {
      description 'Tests from the device whether routers, the server and the internet answer.'
      technology 'fetch timing'
    }
    engine = component 'Analýza sítě / Network analysis' {
      description 'Works out an address\'s path and the network findings from the network map.'
      technology 'JavaScript module'
    }
    guide = component 'Průvodce / Guide' {
      description 'The hkfree.org articles on helping oneself, searchable offline.'
      technology 'JavaScript module'
    }
    advisor = component 'Poradce / Advisor' {
      description 'Answers questions in its own words with a small language model running on the device, from the guide and the last check only.'
      technology 'WebLLM, WebGPU'
    }
    charts = component 'Grafy / Charts' {
      description 'Draws the measurement history of a router on the path and the member\'s own traffic, on request.'
      technology 'TypeScript (LemmaScript), SVG'
    }
    deviceStore = store 'Paměť zařízení / Device memory' {
      description 'What the device remembers: the last network map, its address, how routers usually answer, waiting outage reports.'
      technology 'browser storage'
    }

    check -> diagnostika.backend 'gets the network map and the device\'s address'
    check -> probes 'asks which routers and services answer'
    check -> engine 'asks for the path and the network findings'
    check -> deviceStore 'remembers the map, the address and the usual answers'
    engine -> deviceStore 'reads the last network map'
    charts -> diagnostika.backend 'gets a router\'s measurement history or the device\'s own traffic, only on the member\'s request'
    advisor -> guide 'searches the articles the answer may use'
    advisor -> diagnostika.backend 'downloads the language model once (/models/), only on the member\'s request'
    probes -> pathRouters 'tests reachability'
    probes -> internet 'tests reachability and name resolution'
    probes -> speedtestServer 'measures download, upload and response time, only on the member\'s request'
  }
}
